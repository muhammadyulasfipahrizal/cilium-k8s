global
    log /dev/log local0
    log /dev/log local1 notice

    daemon

    maxconn 2048

defaults
    log global

    mode tcp

    option tcplog

    timeout connect 10s
    timeout client  1m
    timeout server  1m

frontend kubernetes-api
    bind *:6443

    default_backend kubernetes-control-plane

backend kubernetes-control-plane
    balance roundrobin

    option tcp-check

    server k8s-01 192.168.122.234:6443 check
    server k8s-02 192.168.122.44:6443 check
    server k8s-03 192.168.122.19:6443 check